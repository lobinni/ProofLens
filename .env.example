# ProofLens — server environment (Vercel project settings / local .env)
# The browser never sees these values; only the /api serverless functions do.

# --- PostgreSQL (evidence snapshots + scan mirror) ---
# Free tier works fine: neon.tech → create project → copy the connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- GenLayer relayer (must be the contract OWNER of the deployed
# --- ProofLensAttestation contract — writes are owner-gated) ---
# Use a dedicated key for the relayer, never a wallet holding real funds.
GENLAYER_PRIVATE_KEY=""

# --- Optional overrides (defaults work out of the box) ---
# GENLAYER_CONTRACT_ADDRESS="0xeC345794B787fEb03Bb05dB374B0624591608977"
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"   # falls back to VERCEL_URL
# PGSSLMODE="disable"                                  # only for local postgres without TLS

# --- Email sign-in (only saves scan history; wallets stay off) ---
# PROVIDER A · Privy, hosted — identical architecture to the reference app.
# dashboard.privy.io → create app → Login methods: EMAIL ONLY → disable
# embedded wallets. The browser needs only the public App ID; server-side
# token verification uses Privy's public JWKS endpoint, so NO app secret
# is ever required here.
VITE_PRIVY_APP_ID=""
# PRIVY_APP_ID=""            # optional server copy (functions read either)

# PROVIDER B · self-hosted fallback (used when VITE_PRIVY_APP_ID is absent;
# runs the built-in /api/auth OTP). Without RESEND_API_KEY it runs in dev
# mode and returns the code in the API response — fully testable locally.
# RESEND_API_KEY="re_..."
# AUTH_EMAIL_FROM="ProofLens <login@your-domain.xyz>"  # default: onboarding@resend.dev

# --- Session signing secret (self-hosted provider only) ---
# Generate: openssl rand -hex 32. Without it a deterministic development
# secret is derived from DATABASE_URL.
# SESSION_SECRET=""
